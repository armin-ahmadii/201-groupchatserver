#include <arpa/inet.h>
#include <pthread.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/socket.h>
#include <unistd.h>

#define MAX_MSG_SIZE 1024
#define MAX_CLIENTS 100

typedef struct msg_node {
  uint8_t data[MAX_MSG_SIZE];
  int size;
  struct msg_node *next;
} msg_node_t;

typedef struct msg_queue_t {
  msg_node_t *head;
  msg_node_t *tail;
} msg_queue_t;

typedef struct client_info_t {
  int fd;
  struct sockaddr_in addr;
} client_info_t;

int client_fds[MAX_CLIENTS];
int num_connected = 0;
int done_count = 0;
int num_clients = 0;

msg_queue_t queue = {NULL, NULL};

pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
pthread_cond_t cond = PTHREAD_COND_INITIALIZER;

void enqueue(uint8_t *data, int size) {
  msg_node_t *node = malloc(sizeof(msg_node_t));
  memcpy(node->data, data, size);
  node->size = size;
  node->next = NULL;

  if (queue.tail == NULL) {
    queue.head = node;
    queue.tail = node;
  } else {
    queue.tail->next = node;
    queue.tail = node;
  }
}
msg_node_t *dequeue() {
  if (queue.head == NULL)
    return NULL;

  msg_node_t *node = queue.head;
  queue.head = queue.head->next;
  if (queue.head == NULL)
    queue.tail = NULL;

  return node;
}

void *broadcaster_thread(void *arg) {
  (void)arg;

  while (1) {
    pthread_mutex_lock(&lock);

    while (queue.head == NULL) {
      pthread_cond_wait(&cond, &lock);
    }

    msg_node_t *node = dequeue();

    pthread_mutex_unlock(&lock);

    pthread_mutex_lock(&lock);

    for (int i = 0; i < num_connected; i++) {
      send(client_fds[i], node->data, node->size, 0);
    }
    pthread_mutex_unlock(&lock);

    free(node);
  }
}

void *client_thread(void *arg) {
  client_info_t *info = (client_info_t *)arg;
  int fd = info->fd;
  struct sockaddr_in addr = info->addr;
  free(info);

  uint8_t buf[MAX_MSG_SIZE];

  while (1) {
    int idx = 0;
    while (idx < MAX_MSG_SIZE) {
      uint8_t byte;
      int n = recv(fd, &byte, 1, 0);
      if (n <= 0) {
        close(fd);
        return NULL;
      }
      buf[idx++] = byte;
      if (byte == '\n')
        break;
    }
    uint8_t type = buf[0];

    if (type == 0) {
      uint8_t out[MAX_MSG_SIZE];
      int out_size = 0;

      out[out_size++] = 0;

      uint32_t ip = addr.sin_addr.s_addr;
      memcpy(out + out_size, &ip, sizeof(ip));
      out_size += sizeof(ip);

      uint16_t port = addr.sin_port;
      memcpy(out + out_size, &port, sizeof(port));
      out_size += sizeof(port);

      memcpy(out + out_size, buf + 1, idx - 1);
      out_size += idx - 1;

      pthread_mutex_lock(&lock);
      enqueue(out, out_size);
      pthread_cond_signal(&cond);
      pthread_mutex_unlock(&lock);

    } else if (type == 1) {
      pthread_mutex_lock(&lock);
      done_count++;
      int all_done = (done_count == num_clients);
      pthread_mutex_unlock(&lock);

      if (all_done) {
        uint8_t end_msg[2] = {1, '\n'};
        pthread_mutex_lock(&lock);
        for (int i = 0; i < num_connected; i++) {
          send(client_fds[i], end_msg, sizeof(end_msg), 0);
          shutdown(client_fds[i], SHUT_RDWR);
          close(client_fds[i]);
        }
        pthread_mutex_unlock(&lock);
        exit(0);
      }

      close(fd);
      return NULL;
    }
  }
}

int main(int argc, char *argv[]) {
  if (argc != 3) {
    fprintf(stderr, "Usage: %s <port> <# of clients>\n", argv[0]);
    exit(EXIT_FAILURE);
  }

  int port = atoi(argv[1]);
  num_clients = atoi(argv[2]);

  int server_aa = socket(AF_INET, SOCK_STREAM, 0);
  if (server_aa < 0) {
    perror("socket error");
    exit(EXIT_FAILURE);
  }

  int option = 1;
  setsockopt(server_aa, SOL_SOCKET, SO_REUSEADDR, &option, sizeof(option));

  struct sockaddr_in addr;
  memset(&addr, 0, sizeof(addr));
  addr.sin_family = AF_INET;
  addr.sin_addr.s_addr = INADDR_ANY;
  addr.sin_port = htons(port);

  if (bind(server_aa, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
    perror("binding error");
    exit(EXIT_FAILURE);
  }

  if (listen(server_aa, 128) < 0) {
    perror("listen error");
    exit(EXIT_FAILURE);
  }

  printf("Server listening on port %d\n", port);

  pthread_t broadcaster;
  pthread_create(&broadcaster, NULL, broadcaster_thread, NULL);

  while (1) {
    struct sockaddr_in client_addr;
    socklen_t client_len = sizeof(client_addr);

    int client_fd =
        accept(server_aa, (struct sockaddr *)&client_addr, &client_len);
    if (client_fd < 0) {
      perror("accept");
      continue;
    }

    char client_ip[INET_ADDRSTRLEN];
    inet_ntop(AF_INET, &client_addr.sin_addr, client_ip, INET_ADDRSTRLEN);
    printf("Client connected: %s:%d\n", client_ip, ntohs(client_addr.sin_port));

    // close(client_fd);
    pthread_mutex_lock(&lock);
    client_fds[num_connected++] = client_fd;
    pthread_mutex_unlock(&lock);

    client_info_t *info = malloc(sizeof(client_info_t));
    info->fd = client_fd;
    info->addr = client_addr;

    pthread_t t;
    pthread_create(&t, NULL, client_thread, info);
    pthread_detach(t);
  }

  return 0;
}
