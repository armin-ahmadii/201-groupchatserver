#include <arpa/inet.h>
#include <pthread.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/socket.h>
#include <unistd.h>

#define MAX_MSG_SIZE 1024
#define MAX_CLIENTS 100

typedef struct msg_node {
  uint8_t data[MAX_MSG_SIZE];
  int size;
  struct msg_node *next;
} msg_node_t;

typedef struct msg_queue_t {
  msg_node_t *head;
  msg_node_t *tail;
} msg_queue_t;

int client_fds[MAX_CLIENTS];
int num_connected = 0;
int done_count = 0;

msg_queue_t queue = {NULL, NULL};

pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
pthread_cond_t cond = PTHREAD_COND_INITIALIZER;

void enqueue(uint8_t *data, int size) {
  msg_node_t *node = malloc(sizeof(msg_node_t));
  memcpy(node->data, data, size);
  node->size = size;
  node->next = NULL;

  if (queue.tail == NULL) {
    queue.head = node;
    queue.tail = node;
  } else {
    queue.tail->next = node;
    queue.tail = node;
  }
}
msg_node_t *dequeue() {
  if (queue.head == NULL)
    return NULL;

  msg_node_t *node = queue.head;
  queue.head = queue.head->next;
  if (queue.head == NULL)
    queue.tail = NULL;

  return node;
}

int main(int argc, char *argv[]) {
  if (argc != 3) {
    fprintf(stderr, "Usage: %s <port> <# of clients>\n", argv[0]);
    exit(EXIT_FAILURE);
  }

  int port = atoi(argv[1]);
  int num_clients = atoi(argv[2]);

  int server_aa = socket(AF_INET, SOCK_STREAM, 0);
  if (server_aa < 0) {
    perror("socket error");
    exit(EXIT_FAILURE);
  }

  int option = 1;
  setsockopt(server_aa, SOL_SOCKET, SO_REUSEADDR, &option, sizeof(option));

  struct sockaddr_in addr;
  memset(&addr, 0, sizeof(addr));
  addr.sin_family = AF_INET;
  addr.sin_addr.s_addr = INADDR_ANY;
  addr.sin_port = htons(port);

  if (bind(server_aa, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
    perror("binding error");
    exit(EXIT_FAILURE);
  }

  if (listen(server_aa, 128) < 0) {
    perror("listen error");
    exit(EXIT_FAILURE);
  }

  printf("Server listening on port %d\n", port);

  while (1) {
    struct sockaddr_in client_addr;
    socklen_t client_len = sizeof(client_addr);

    int client_fd =
        accept(server_aa, (struct sockaddr *)&client_addr, &client_len);
    if (client_fd < 0) {
      perror("accept");
      continue;
    }

    char client_ip[INET_ADDRSTRLEN];
    inet_ntop(AF_INET, &client_addr.sin_addr, client_ip, INET_ADDRSTRLEN);
    printf("Client connected: %s:%d\n", client_ip, ntohs(client_addr.sin_port));

    close(client_fd);
  }

  return 0;
}
